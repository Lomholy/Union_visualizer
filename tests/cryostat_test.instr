DEFINE INSTRUMENT cryostat_test (
E0 = 13.725, 
dE = 0.05, 
A3_angle = 18.656, 
phi = 57, 
tag_angle = -142.5, 
tag_time = 0.0016015, 
tag_interval = 5E-06, 
double conditional_xwidth = 0.13 
)

DECLARE 
%{
double q_min;
double q_max;
double max_speed;
double min_speed;
double tmin_cryo;
double tmax_cryo;
int flag1;
int n_scattering;
double tmin;
double tmax;
char option_string[1024];
%}

INITIALIZE 
%{
// Start of initialize for generated cryostat_test
q_max = 1.05*2*V2K*SE2V*sqrt(E0+dE);
q_min = -q_max;
q_max = 1.05*2*V2K*SE2V*sqrt(E0+dE);
q_min = -q_max;
max_speed = sqrt(E0 + dE)*SE2V;
min_speed = sqrt(E0 - dE)*SE2V;
tmin_cryo = (2.0-0.15)/max_speed;
tmax_cryo = (2.0+0.45)/min_speed;
tmin = (2.5-0.15)/max_speed;
tmax = (2.5+0.65)/min_speed;
sprintf(option_string, "banana, theta limits=[-180,180] bins=721, t limits=[%lf %lf] bins=1000", tmin, tmax);
%}

TRACE 
COMPONENT progress = Progress_bar()
AT (0,0,0) ABSOLUTE

COMPONENT source = Source_simple(
 yheight = 0.01, xwidth = 0.01,
 dist = 2, focus_xw = 0.01,
 focus_yh = 0.01, E0 = E0,
 dE = dE)
AT (0,0,0) ABSOLUTE

COMPONENT init = Union_init()
AT (0,0,0) ABSOLUTE

COMPONENT orange = Arm()
AT (0,0,2) RELATIVE source

COMPONENT Al_inc = Incoherent_process(
