AT (0,0,0) RELATIVE orange

COMPONENT YBaCuO_incoherent = Incoherent_process(
 sigma = 2.105, unit_cell_volume = 173.28)
AT (0,0,0) ABSOLUTE

COMPONENT YBaCuO_crystal = Single_crystal_process(
 reflections = "YBaCuO.lau", delta_d_d = 0.0005,
 mosaic = 30, barns = 1,
 ax = 3.816, ay = 0,
 az = 0, bx = 0,
 by = 3.886, bz = 0,
 cx = 0, cy = 0,
 cz = 11.677)
AT (0,0,0) ABSOLUTE

COMPONENT YBaCuO = Union_make_material(
 process_string = "YBaCuO_incoherent,YBaCuO_crystal", my_absorption = 8.55263)
AT (0,0,0) ABSOLUTE

COMPONENT sample_position_y_rotated = Arm()
AT (0,0,0) RELATIVE orange
ROTATED (0,A3_angle,0) RELATIVE orange

COMPONENT sample_position = Arm()
AT (0,0,0) RELATIVE sample_position_y_rotated
ROTATED (phi,0,0) RELATIVE sample_position_y_rotated

COMPONENT sample = Union_box(
 material_string = "YBaCuO", priority = 200,
 xwidth = 0.006, yheight = 0.012,
 zdepth = 0.005)
AT (0,0,0) RELATIVE sample_position

COMPONENT vertical = Union_box(
 material_string = "Al", priority = 300,
 xwidth = 0.0025, yheight = 0.012,
 zdepth = 0.007)
AT (0.004350000000000001,0.0065,0) RELATIVE sample_position_y_rotated

COMPONENT top = Union_cylinder(
 material_string = "Al", priority = 290,
 radius = 0.0036, yheight = 0.002)
AT (0,0.012,0) RELATIVE sample_position_y_rotated

COMPONENT sample_rod = Union_cylinder(
 material_string = "Al", priority = 310,
 radius = 0.006, yheight = 1.2)
AT (0,0.60098,0) RELATIVE top

COMPONENT spot_dir = Arm()
AT (0,0,0) RELATIVE orange
ROTATED (0,tag_angle,0) RELATIVE orange

COMPONENT space_all_PSD_conditional = Union_conditional_PSD(
 target_loggers = "logger_2D_space_con_zx_all,logger_2D_space_con_zx_1,logger_2D_space_con_zx_2,logger_2D_space_con_zx_3,logger_2D_space_con_zx_4,logger_2D_space_con_zx_5,logger_2D_space_con_zx_6,logger_2D_space_con_zy_all,logger_2D_space_con_zy_1,logger_2D_space_con_zy_2,logger_2D_space_con_zy_3,logger_2D_space_con_zy_4,logger_2D_space_con_zy_5,logger_2D_space_con_zy_6,logger_2D_space_con_xy_all,logger_2D_space_con_xy_1,logger_2D_space_con_xy_2,logger_2D_space_con_xy_3,logger_2D_space_con_xy_4,logger_2D_space_con_xy_5,logger_2D_space_con_xy_6,logger_2DQ_con_zx_all,logger_2DQ_con_zx_1,logger_2DQ_con_zx_2,logger_2DQ_con_zx_3,logger_2DQ_con_zx_4,logger_2DQ_con_zx_5,logger_2DQ_con_zx_6,logger_2DQ_con_zy_all,logger_2DQ_con_zy_1,logger_2DQ_con_zy_2,logger_2DQ_con_zy_3,logger_2DQ_con_zy_4,logger_2DQ_con_zy_5,logger_2DQ_con_zy_6,logger_2DQ_con_xy_all,logger_2DQ_con_xy_1,logger_2DQ_con_xy_2,logger_2DQ_con_xy_3,logger_2DQ_con_xy_4,logger_2DQ_con_xy_5,logger_2DQ_con_xy_6", xwidth = conditional_xwidth,
 yheight = 0.2, time_min = tag_time-0.5*tag_interval,
 time_max = tag_time+0.5*tag_interval)
AT (0,0,0.5) RELATIVE spot_dir

COMPONENT master = Union_master(
 verbal = 0)
AT (0,0,0) ABSOLUTE
EXTEND %{
flag1 = logger_conditional_extend_array[1];
n_scattering = number_of_scattering_events;
%}

COMPONENT stop = Union_stop()
AT (0,0,0) ABSOLUTE

COMPONENT banana_detector = Monitor_nD(
 yheight = 0.2, restore_neutron = 1,
 radius = 0.5, options = option_string,
 filename = "tof_b.dat")
AT (0,0,0) RELATIVE orange

COMPONENT banana_detector_1 = Monitor_nD(
 yheight = 0.2, restore_neutron = 1,
 radius = 0.5, options = option_string,
 filename = "tof_b_1.dat")
WHEN (n_scattering == 1)
AT (0,0,0) RELATIVE orange

COMPONENT banana_detector_2 = Monitor_nD(
 yheight = 0.2, restore_neutron = 1,
 radius = 0.5, options = option_string,
 filename = "tof_b_2.dat")
WHEN (n_scattering == 2)
AT (0,0,0) RELATIVE orange

COMPONENT banana_detector_3 = Monitor_nD(
 yheight = 0.2, restore_neutron = 1,
 radius = 0.5, options = option_string,
 filename = "tof_b_3.dat")
WHEN (n_scattering == 3)
AT (0,0,0) RELATIVE orange

COMPONENT banana_detector_4 = Monitor_nD(
 yheight = 0.2, restore_neutron = 1,
 radius = 0.5, options = option_string,
 filename = "tof_b_4.dat")
WHEN (n_scattering == 4)
AT (0,0,0) RELATIVE orange

COMPONENT banana_detector_5 = Monitor_nD(
 yheight = 0.2, restore_neutron = 1,
 radius = 0.5, options = option_string,
 filename = "tof_b_5.dat")
WHEN (n_scattering == 5)
AT (0,0,0) RELATIVE orange

COMPONENT banana_detector_6 = Monitor_nD(
 yheight = 0.2, restore_neutron = 1,
 radius = 0.5, options = option_string,
 filename = "tof_b_6.dat")
WHEN (n_scattering == 6)
AT (0,0,0) RELATIVE orange

COMPONENT banana_detector_limited = Monitor_nD(
 yheight = 0.2, restore_neutron = 1,
 radius = 0.5, options = option_string,
 filename = "tof_b_limited.dat")
WHEN (flag1 > 0)
AT (0,0,0) RELATIVE orange

COMPONENT Emon = E_monitor(
 nE = 300, xwidth = 0.04,
 yheight = 0.04, Emin = E0 - dE,
 Emax = E0 + dE, restore_neutron = 1)
AT (0,0,0.5) RELATIVE orange

FINALLY 
%{
// Start of finally for generated cryostat_test
%}

END
