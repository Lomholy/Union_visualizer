DEFINE INSTRUMENT ODIN (

)

DECLARE 
%{
%}

INITIALIZE 
%{



%}

TRACE 

COMPONENT Origin = Progress_bar(

)
AT (0,0,0) RELATIVE ABSOLUTE


COMPONENT src = Source_simple(
radius = 1, lambda0 = 3, dlambda = 2,
focus_xw = 2,
focus_yh = 2


)
AT (0,0,0) RELATIVE ABSOLUTE


COMPONENT sample = Arm(

)
AT (0,0,10) RELATIVE src

COMPONENT right = Arm(
)
AT (0.5,0,0) RELATIVE sample
ROTATED (0,0,0) RELATIVE sample


COMPONENT left = Arm(
)
AT (-0.5,0,0) RELATIVE sample
ROTATED (0,0,00) RELATIVE sample

COMPONENT init = Union_init(

)
AT (0,0,0) RELATIVE PREVIOUS

COMPONENT non = Non_process(

)
AT (0,0,0) RELATIVE PREVIOUS


COMPONENT mat = Union_make_material(
    my_absorption = 100, process_string="non" 
)
AT (0,0,0) RELATIVE PREVIOUS


COMPONENT box_left = Union_box(
    priority = 10,
    xwidth = 0.5,
    yheight = 0.5,
    zdepth = 0.5,
    material_string = "mat"
)
AT (0,0,0) RELATIVE left

COMPONENT sph_left = Union_sphere(
    priority = 1,
    radius = 0.2,
    mask_string = "box_left",
    mask_setting = "All",
    material_string = "mat"
)
